{
  "name": "laurel-ui",
  "version": "1.0.0",
  "description": "Laurel-UI V1.0 — Antik Roma'dan esinlenen, Next.js (App Router) için React bileşen kütüphanesi",
  "author": "Berke İnselman — INSLMN Software Solutions & Experience Consultancy",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/berke-inselman/laurelui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berke-inselman/laurelui.git"
  },
  "bugs": {
    "url": "https://github.com/berke-inselman/laurelui/issues"
  },
  "type": "module",
  "sideEffects": [
